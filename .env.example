# ── Server ─────────────────────────────
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://REPLACE_WITH_YOUR_DOMAIN
# Uncomment ONLY if frontend and API are on different origins/ports over HTTPS
# CROSS_SITE_COOKIES=true

# ── PostgreSQL database (REQUIRED) ──
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?sslmode=require

# ── Auth ───────────────────────────────
# Generate: node -e "console.log(require('bcryptjs').hashSync('YOUR-PASSWORD', 12))"
DASHBOARD_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX

# ── Google OAuth (REQUIRED for sending mail) ──
GOOGLE_CLIENT_ID=REPLACE_WITH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=REPLACE_WITH_REFRESH_TOKEN

# ── Sender identity ────────────────────
GMAIL_SENDER=REPLACE_WITH_SENDING_ADDRESS@gmail.com
GMAIL_SENDER_NAME=REPLACE_WITH_YOUR_BUSINESS_NAME
REPLY_TO=REPLACE_WITH_REPLY_ADDRESS@gmail.com

# ── Business identity ──────────────────
# One of: ecommerce | saas | finance | media | healthcare | general
BUSINESS_TYPE=general
BUSINESS_NAME=REPLACE_WITH_YOUR_BUSINESS_NAME

# ── Links used in email templates ──────
SITE_URL=https://REPLACE_WITH_YOUR_DOMAIN/
SUPPORT_URL=https://REPLACE_WITH_YOUR_DOMAIN/support
UNSUBSCRIBE_URL=https://REPLACE_WITH_YOUR_DOMAIN/unsubscribe

# ── API keys for webhooks & sync ───────
# Generate each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_API_KEY=REPLACE_WITH_64_CHAR_HEX
AUTOMATION_API_KEY=REPLACE_WITH_64_CHAR_HEX

BUSINESS_TYPE=general
BUSINESS_NAME=My Business
SITE_URL=https://my-domain.com/

# ── Internal support team (optional) ───
# SUPPORT_TEAM_EMAIL=team@REPLACE_WITH_YOUR_DOMAIN

# ── Unsubscribe signing (optional) ─────
# UNSUBSCRIBE_SECRET=REPLACE_WITH_64_CHAR_HEX